# ── 資料庫（Supabase）──────────────────────────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string
# 建議用 Session pooler 或 Transaction pooler（IPv4 可用），例如：
# DATABASE_URL=postgresql://postgres.gndrrgqihsbweocoedvp:<密碼>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# 本機開發留空 → 自動用 PGlite（data/pglite）
DATABASE_URL=

# ── 登入 session 簽名密鑰（正式環境必填，最少 32 字符）───────────
# 生成：openssl rand -hex 32
SESSION_SECRET=

# ── 店主戶口（開機時如果未有店主就用呢組建立；建立後可以刪走）──
OWNER_USERNAME=
OWNER_PASSWORD=
OWNER_NAME=店主

# ── 示範模式（true = 開放 Demo 一撳登入 + 自動生成示範資料）─────
# 正式開舖一定要 false
DEMO_MODE=false
