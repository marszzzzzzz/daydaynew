# Postgres — added automatically when you connect Neon in Vercel → Storage
DATABASE_URL=
# Vercel Blob (private) — added automatically when you connect a Blob store
BLOB_READ_WRITE_TOKEN=
# Optional: system-sent e-mail through Resend
RESEND_API_KEY=
MAIL_FROM="名片簿 <noreply@cards.example.com>"
RESEND_WEBHOOK_SECRET=
# Optional: mixed into session-token hashes (openssl rand -base64 32)
SESSION_SECRET=
# Public address used in share links (defaults to the production domain)
APP_URL=
